#A New Approach 

library(pheatmap)
library(grid)
library(gridExtra)
library(ggplot2)

# Create the heatmap object without immediate plotting

heatmap_plot <- pheatmap(
  log2fc_matrix,
  color = heat_colors,
  cluster_rows = TRUE,
  show_colnames = TRUE,
  annotation_col = annotation,
  annotation_colors = ann_colors,
  fontsize = 22,
  fontsize_row = 22,
  fontsize_col = 22,
  fontsize_number = 22,
  main = "",
  silent = TRUE  # To modify the plot before saving
)


# Define the custom title and combine with heatmap

final_plot <- grid.arrange(
  heatmap_plot$gtable,
  top = textGrob(
    "NSCLC After Treatment (Responder vs Nonresponder)",
    gp = gpar(fontsize = 28, fontface = "bold")
  )
)



# Save the final plot using ggsave for high-quality output

ggsave(
  filename = "NSCLC_Heatmap.jpeg",
  plot = final_plot,
  width = 11, height = 14,   # Width and height in inches
  dpi = 1200,                # High resolution (DPI)
  units = "in",              # Specify units
  device = "jpeg"            # Save as JPEG format
)



