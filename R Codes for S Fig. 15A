# A Complete Volcano Plot R Codes   

# Loading relevant libraries 

library(tidyverse)
library(RColorBrewer)
library(ggrepel)
library(ggplot2)
library(dplyr)



# Import the data table  

df <- Counts_Data<-read.csv('Genes_VolcanoPlot.csv')

head(df)

dim(df)

#For Omitting the NA Data 
df <- na.omit(df)
df
dim(df)




#Screening the Data (I didn't use it)

df <- df[(abs(df$log2fc) > 1.0),]
df
dim(df)


# Create a basic volcano plot

ggplot(data = df, aes(x = log2fc, y = -log10(pval))) +
  geom_point()




# Biostatsquid theme

theme_set(theme_classic(base_size = 20) +
            theme(
              axis.title.y = element_text(face = "bold", margin = margin(0,20,0,0), size = rel(1.1), color = 'black'),
              axis.title.x = element_text(hjust = 0.5, face = "bold", margin = margin(20,0,0,0), size = rel(1.1), color = 'black'),
              plot.title = element_text(hjust = 0.5)
            ))



# General VolcanoPlot
ggplot(data = df, aes(x = log2fc, y = -log10(pval))) +
  geom_vline(xintercept = c(-0.3, 0.3), col = "gray", linetype = 'dashed') +
  geom_hline(yintercept = c(-log10(0.05)), col = "gray", linetype = 'dashed') + 
  geom_point()




# Add a column to the data frame to specify if they are UP- or DOWN- regulated (log2fc respectively positive or negative)<br /><br /><br />

df$diffexpressed <- "NO"


# if log2Foldchange > 0.6 and pvalue < 0.05, set as "UP"

df$diffexpressed[df$log2fc > 0.3 & df$pval < 0.05] <- "UP"

# if log2Foldchange < -0.6 and pvalue < 0.05, set as "DOWN"<

df$diffexpressed[df$log2fc < -0.3 & df$pval < 0.05] <- "DOWN"





# Edit axis labels and limits

ggplot(data = df, aes(x = log2fc, y = -log10(pval), col = diffexpressed)) +
  geom_vline(xintercept = c(-0.3, 0.3), col = "gray", linetype = 'dashed') +
  geom_hline(yintercept = c(-log10(0.05)), col = "gray", linetype = 'dashed') + 
  geom_point(size = 3) + 
  scale_color_manual(values = c("#00AFBB", "grey", "#bb0c00"), # to set the colours of our variable  
                     labels = c("Downregulated", "Not significant", "Upregulated")) + # to set the labels in case we want to overwrite the categories from the dataframe (UP, DOWN, NO)
  coord_cartesian(ylim = c(0, 250), xlim = c(-1.5, 1.5)) + # since some genes can have minuslog10padj of inf, we set these limits
  labs(color = 'Expressed Genes',  
       x = expression("log"[2]*"FC"), y = expression("-log"[10]*"p-value")) + 
  scale_x_continuous(breaks = seq(-1.5, 1.5, 0.5))




#Add the Gene Names in the Volcano Plot 

top30degs <- head(df[order(df$pval), 'gene_symbol'], 15)

top_genes

# Create a new column "delabel" to de, that will contain the name of the top 30 differentially expressed genes (NA in case they are not)

df$delabel <- ifelse(df$gene_symbol %in% top30degs, df$gene_symbol, NA)




myvolcanoplot <- ggplot(data = df, aes(x = log2fc, y = -log10(pval), col = diffexpressed, label = delabel)) +
  geom_vline(xintercept = c(-0.6, 0.6), col = "gray", linetype = 'dashed') +
  geom_hline(yintercept = -log10(0.05), col = "gray", linetype = 'dashed') +
  geom_point(size = 2) +
  scale_color_manual(values = c("#00AFBB", "grey", "#bb0c00"), # to set the colours of our variable<br />
                     labels = c("Downregulated", "Not Significant", "Upregulated")) + # to set the labels in case we want to overwrite the categories from the dataframe (UP, DOWN, NO)<br />
  coord_cartesian(ylim = c(0, 100), xlim = c(-6, 6)) + # since some genes can have minuslog10padj of inf, we set these limits<br />
  labs(color = 'Expression',
       x = expression("log"[2]*"FC"), y = expression("-log"[10]*"p-value")) +
  scale_x_continuous(breaks = seq(-6, 6, 2)) + # to customise the breaks in the x axis<br />
  ggtitle('NSCLC After Treatment (Responder vs Non-responder)') + # Plot title<br />
  geom_text_repel(size = 7, max.overlaps = Inf) +
  theme(
    plot.title = element_text(size = 20, face = "bold")  # Reduce title font size
  )







myvolcanoplot


jpeg("./Final_VolcanoPlot.jpeg", res = 1200, width = 11000, height = 10000)

print(myvolcanoplot)

dev.off()


